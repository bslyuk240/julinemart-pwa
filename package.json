{
  "name": "julinemart-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=262144 next dev",
    "build": "cross-env NODE_OPTIONS=--max-http-header-size=262144 next build",
    "start": "cross-env NODE_OPTIONS=--max-http-header-size=262144 next start",
    "lint": "cross-env NODE_OPTIONS=--max-http-header-size=262144 next lint",
    "analyze": "cross-env NODE_OPTIONS=--max-http-header-size=262144 ANALYZE=true next build",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
