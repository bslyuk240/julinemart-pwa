    "@capacitor/push-notifications": "^8.0.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.59.20",
    "@woocommerce/woocommerce-rest-api": "^1.0.1",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "firebase": "^12.9.0",
